[Unit]
Description=ServerMonitor Telegram monitoring bot
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=monitor
Group=monitor
WorkingDirectory=/home/monitor/Servermonitoring
ExecStart=/home/monitor/Servermonitoring/.venv/bin/python -u /home/monitor/Servermonitoring/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target