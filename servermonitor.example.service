[Unit]
Description=ServerMonitor Telegram monitoring bot
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=vihruta
Group=vihruta
WorkingDirectory=/home/user/Projects/Servermonitoring
ExecStart=/home/user/Projects/Servermonitoring/.venv/bin/python -u /home/user/Projects/Servermonitoring/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target